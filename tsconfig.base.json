{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@carrom/types": ["packages/types/src/index.ts"],
      "@carrom/config": ["packages/config/src/index.ts"],
      "@carrom/physics": ["packages/physics/src/index.ts"],
      "@carrom/game-engine": ["packages/game-engine/src/index.ts"],
      "@carrom/content": ["packages/content/src/index.ts"],
      "@carrom/networking": ["packages/networking/src/index.ts"],
      "@carrom/ui": ["packages/ui/src/index.ts"]
    }
  }
}
