# Values here are mirrored into app.json -> expo.extra, which is how the app
# reads them at runtime. None of these are secrets.

# Where the API is reachable from the device. On a physical phone this must be
# your machine's LAN address, not localhost.
API_URL=http://192.168.1.10:4000

# Facebook App ID. Add the Android and iOS platforms in the Facebook dashboard
# with the package name / bundle id from app.json.
FACEBOOK_APP_ID=

# Google OAuth client ids, one per platform.
GOOGLE_EXPO_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
