##############################################################################
# Carrom API configuration
#
# Copy to .env and fill in. Every value here has a safe development default
# except the OAuth credentials, which you must create yourself.
##############################################################################

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated browser origins allowed to call the API and open a socket.
# Include your web app and admin app.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://172.20.10.2:3000,http://172.20.10.2:8081,exp://172.20.10.2:8081

# ---------------------------------------------------------------------------
# Postgres. `npm run docker:up` starts one matching this URL.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://carrom:carrom@localhost:5432/carrom
DB_POOL_MAX=20

# ---------------------------------------------------------------------------
# Redis backs presence, matchmaking queue depth and rate limiting. The API runs
# without it on a single node, using in-process fallbacks.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380
REDIS_ENABLED=true

# ---------------------------------------------------------------------------
# JWT signing. Use two DIFFERENT long random strings.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production while these are the defaults.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# ---------------------------------------------------------------------------
# Facebook Login
#   1. https://developers.facebook.com/apps -> Create app -> "Authenticate and
#      request data from users with Facebook Login"
#   2. Settings -> Basic: copy the App ID and App Secret here.
#   3. Facebook Login -> Settings -> Valid OAuth Redirect URIs: add your web
#      origin (e.g. http://localhost:3000).
#   4. For mobile, add the Android/iOS platform with your package name and
#      bundle id.
#   5. Point the "Deauthorize callback URL" at POST /auth/facebook/deauthorize
#      so removed permissions are recorded.
#
# The secret is used server-side only, to verify tokens with debug_token.
# It must never be shipped to a client.
# ---------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------------------------------------------------------------------------
# Google Sign-In
#   Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
#   Create a Web client; add your web origin to Authorized JavaScript origins.
#   Only the client id is needed: ID tokens are verified against Google.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Sign-in policy
# ---------------------------------------------------------------------------
# Guests can play immediately and upgrade later without losing progress.
ALLOW_GUEST=true
# Guest play in production must be confirmed explicitly.
ALLOW_GUEST_IN_PROD=false
# When true, an email account must be verified before it can sign in.
REQUIRE_EMAIL_VERIFICATION=false

# Used to build verification and password-reset links.
PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Object storage for avatars (S3-compatible). Uploads are disabled when unset.
# ---------------------------------------------------------------------------
STORAGE_BUCKET_URL=

# Identifies this instance in matchmaking logs. Set per pod when scaling out.
NODE_ID=
